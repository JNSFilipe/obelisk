{
  lib,
  pkgs,
  ...
}:

# Fish, installed alongside Zsh and Nushell rather than replacing Zsh as the
# login shell (see nix/darwin.nix); started explicitly with `fish`.
#
# Replicates the CachyOS + Pure + Autopair + Done setup from baum, combined
# with Obelisk's macOS aliases/helpers, zoxide, and atuin.
#
# Home Manager's `programs.fish` module does not support `package = null` and
# unconditionally adds Nix's `fish` binary to `home.packages`. To keep Homebrew
# as the sole owner of the `fish` runtime, render `~/.config/fish` directly via
# `xdg.configFile`. The pure-script Fish plugins (`pure`, `autopair`, `done`)
# have no Homebrew formulae (Homebrew's `pure` formula is the Zsh prompt), so
# their source trees are wired from `pkgs.fishPlugins` just like `tmuxPlugins`
# in `nix/home.nix`.

let
  plugins = [
    {
      name = "autopair";
      inherit (pkgs.fishPlugins.autopair) src;
    }
    {
      name = "done";
      inherit (pkgs.fishPlugins.done) src;
    }
    {
      name = "pure";
      inherit (pkgs.fishPlugins.pure) src;
    }
  ];

  shellAliases = {
    # ls variants — gls is GNU ls from brew coreutils.
    ls = "gls --color=auto";
    la = "gls --color=auto -A";
    ll = "gls --color=auto -al";
    # Editors
    vi = "nvim";
    vim = "nvim";
    ec = "emacsclient -c";
    et = "emacsclient -t";
    # Network / transfer
    ww = "wget";
    wget = "wget -c ";
    tb = "nc termbin.com 9999";
    # System / archives
    del = "sudo rm -r";
    comp = "sudo make install";
    tarnow = "tar -acf ";
    untar = "tar -zxvf ";
    # Navigation shortcuts (from baum / CachyOS; `cd` itself comes from zoxide)
    ".." = "cd ..";
    "..." = "cd ../..";
    "...." = "cd ../../..";
    "....." = "cd ../../../..";
    "......" = "cd ../../../../..";
    # Grep color
    grep = "grep --color=auto";
    fgrep = "fgrep --color=auto";
    egrep = "egrep --color=auto";
    # Git
    gl = "git clone";
    lg = "lazygit";
    rcp = "rsync -avzh --progress --stats";
    # Homebrew helpers
    brewdeps = "brew deps --installed --tree";
    brewup = "brew upgrade --greedy";
    caskup = "brew upgrade --cask --greedy";
    brewrm-msupdate = "brew uninstall microsoft-auto-update";
  };

  aliasesStr = lib.concatStringsSep "\n" (
    lib.mapAttrsToList (name: value: "alias ${name} ${lib.escapeShellArg value}") shellAliases
  );
in
{
  xdg.configFile = lib.mkMerge (
    map (plugin: {
      "fish/conf.d/plugin-${plugin.name}.fish".text = ''
        # Plugin ${plugin.name}
        set -l plugin_dir ${plugin.src}

        if test -d $plugin_dir/functions
          set fish_function_path $fish_function_path[1] $plugin_dir/functions $fish_function_path[2..-1]
        end

        if test -d $plugin_dir/completions
          set fish_complete_path $fish_complete_path[1] $plugin_dir/completions $fish_complete_path[2..-1]
        end

        if test -d $plugin_dir/conf.d
          for f in $plugin_dir/conf.d/*.fish
            source $f
          end
        end

        if test -f $plugin_dir/key_bindings.fish
          source $plugin_dir/key_bindings.fish
        end

        if test -f $plugin_dir/init.fish
          source $plugin_dir/init.fish
        end
      '';
    }) plugins
    ++ [
      {
        "fish/config.fish".text = ''
          # ~/.config/fish/config.fish: generated by Home Manager (nix/fish.nix).

          set -q __fish_obelisk_config_sourced; and exit
          set -g __fish_obelisk_config_sourced 1

          # ── Environment & PATH ──────────────────────────────────────────────
          # Fish does not source POSIX profile scripts, so restate session
          # variables and PATH entries here for both login and subshell runs.
          set -gx EDITOR "emacsclient -t"
          set -gx VISUAL "emacsclient -c"
          set -gx _ZO_DOCTOR "0"

          # Settings for https://github.com/franciscolourenco/done (from baum)
          set -g __done_min_cmd_duration 10000
          set -g __done_notification_urgency_level low

          fish_add_path --global --path --move \
            /opt/homebrew/bin \
            /opt/homebrew/sbin \
            /opt/homebrew/opt/man-db/libexec/bin \
            /opt/homebrew/opt/llvm/bin \
            /opt/homebrew/opt/rustup/bin \
            /opt/homebrew/opt/postgresql@18/bin

          fish_add_path --global --path --move \
            "$HOME/.local/bin" \
            "$HOME/.cargo/bin" \
            "$HOME/.config/scripts" \
            /Library/TeX/texbin \
            "$HOME/Applications/depot_tools"

          if test -f "$HOME/.fish_profile"
            source "$HOME/.fish_profile"
          end

          status is-interactive; and begin
            # ── Aliases ─────────────────────────────────────────────────────────
          ${aliasesStr}

          ${builtins.readFile ../configs/fish/config.fish}
          end
        '';
      }
    ]
  );
}
