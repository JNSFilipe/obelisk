(ert-deftest gloom-meow-undo-and-redo ()
  (save-window-excursion
    (let ((buffer (generate-new-buffer "gloom-undo-test")))
      (unwind-protect
          (progn
            (switch-to-buffer buffer)
            (emacs-lisp-mode)
