;;; ssh-test.el --- Offline SSH command tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(load (expand-file-name "../obelisk-ssh.el"
                        (file-name-directory (or load-file-name buffer-file-name))))

(ert-deftest obelisk-ssh-paths-and-history ()
  (let (obelisk-ssh-user-history obelisk-ssh-host-history opened)
    (cl-letf (((symbol-function 'dired) (lambda (path) (setq opened path))))
      (dolist (case '(("alice" "192.0.2.1" nil "22")
                      ("bob" "device.example" "2222" "2222")
                      ("alice" "2001:db8::1" 2200 "2200")))
        (apply #'obelisk-ssh (cl-subseq case 0 3))
        (let ((vec (tramp-dissect-file-name opened)))
          (should (equal (tramp-file-name-method vec) "ssh"))
          (should (equal (tramp-file-name-user vec) (nth 0 case)))
          (should (equal (tramp-file-name-host vec) (nth 1 case)))
          (should (equal (tramp-file-name-port vec) (nth 3 case)))
          (should (equal (tramp-file-name-localname vec) "~/"))))
      (should (member "alice" obelisk-ssh-user-history))
      (should (member "device.example" obelisk-ssh-host-history)))))

(ert-deftest obelisk-ssh-rejects-invalid-input ()
  (cl-letf (((symbol-function 'dired) (lambda (&rest _) (ert-fail "Opened remote path"))))
    (dolist (args '(("" "host" 22) ("alice" "" 22)
                    ("alice@other" "host" 22) ("alice" "host|other" 22)
                    ("alice" "host" 0) ("alice" "host" 65536)
                    ("alice" "host" "22oops") ("alice" "host" "")))
      (should-error (apply #'obelisk-ssh args) :type 'user-error))))

(ert-deftest obelisk-ssh-persists-completion-histories ()
  (require 'savehist)
  (should (memq 'obelisk-ssh-user-history savehist-additional-variables))
  (should (memq 'obelisk-ssh-host-history savehist-additional-variables)))

(ert-deftest obelisk-ssh-interactive-prompts ()
  (let (obelisk-ssh-user-history obelisk-ssh-host-history histories opened
        (answers '("alice" "192.0.2.5")))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt _collection _predicate _match _initial history &rest _)
                 (push history histories)
                 (pop answers)))
              ((symbol-function 'read-string)
               (lambda (_prompt _initial _history default &rest _)
                 (should (equal default "22")) default))
              ((symbol-function 'dired) (lambda (path) (setq opened path))))
      (call-interactively #'obelisk-ssh)
      (should (equal (reverse histories)
                     '(obelisk-ssh-user-history obelisk-ssh-host-history)))
      (should (equal opened "/ssh:alice@192.0.2.5#22:~/")))))
;;; ssh-test.el ends here
